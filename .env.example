# Robot Command Controller — Environment Configuration
# Copy to .env and customize

# Application
APP_ROBOT_ID=robot-01
APP_LOG_LEVEL=INFO
APP_LOG_FORMAT=json
APP_COMMANDS_FILE=data/commands.json
APP_ENTITY_CACHE_MAXSIZE=500
APP_ENTITY_CACHE_TTL=300
APP_QUEUE_MAXSIZE=50
APP_MAX_CONCURRENT_LLM=1

# MQTT
MQTT_HOST=localhost
MQTT_PORT=1883
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_CLIENT_ID=robot-command-controller
MQTT_KEEPALIVE=60
MQTT_QOS=1

# MongoDB
MONGO_URI=mongodb://127.0.0.1:27017
MONGO_DATABASE=xtend_robotics
# Map slot_type → collection name. Add new entity types here without touching code.
MONGO_COLLECTIONS='{"users":"users","locations":"locations"}'

# LLM (llama-server)
LLM_BASE_URL=http://127.0.0.1:8080
LLM_MODEL=qwen2.5-7b-instruct
LLM_TIMEOUT=30.0
LLM_MAX_TOKENS=1024
LLM_TEMPERATURE=0.1
LLM_GRAMMAR_PATH=grammars/commands.gbnf
LLM_SYSTEM_PROMPT_PATH=data/system_prompt.txt
